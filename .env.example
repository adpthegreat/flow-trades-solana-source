# flow-trades — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env

# ══════════════════════════════════════════════════
# Required
# ══════════════════════════════════════════════════

# Solana RPC endpoint (mainnet)
RPC_URL='https://your-solana-rpc-endpoint.com'

# ══════════════════════════════════════════════════
# Fee Collection (router program + fee rate are hardcoded)
# ══════════════════════════════════════════════════

# Protocol fee token account — receives 30% of 0.5% platform fee.
# FEE_ACCOUNT='YourProtocolTokenAccount...'

# Integrator referral token account — receives 70% of 0.5% platform fee.
# Set this to earn revenue from every swap.
# REFERRAL_ACCOUNT='YourIntegratorTokenAccount...'

# ══════════════════════════════════════════════════
# API Server
# ══════════════════════════════════════════════════

# Listen address (default: 127.0.0.1:8080)
# LISTEN_ADDR='127.0.0.1:8080'

# ══════════════════════════════════════════════════
# Pool Discovery & Streaming
# ══════════════════════════════════════════════════

# Block scanner: discovers new pools from live blocks (default: enabled)
# BLOCK_SCAN_ENABLED=true
# BLOCK_SCAN_INTERVAL_MS=2000

# Discovery mode: auto (default — block scanner enabled), none (manual pools only)
# DISCOVERY_MODE='auto'

# ══════════════════════════════════════════════════
# Persistence
# ══════════════════════════════════════════════════

# SQLite pool database path
# POOL_DB_PATH='./pools.db'

# Stale pool pruning (remove pools not seen in N days)
# PRUNE_INTERVAL_SECS=3600
# PRUNE_MAX_AGE_DAYS=7

# Legacy file-based persistence (fallback only)
# WARM_STORAGE_PATH='./pool-state.bin'
# SNAPSHOT_PATH='./pool-snapshot.json'

# ══════════════════════════════════════════════════
# Address Lookup Tables (v0 versioned transactions)
# ══════════════════════════════════════════════════

# Comma-separated ALT addresses for smaller transactions
# ALT_ADDRESSES='BrQp6dwBFCdUfrvgnqzw9tc9kLPXTn16AmjZE8xJanMM,AoRtqBqk7Ysf3cd5NWjs93E2ekmz9KG1wLV84v7Xa1KK'
# ALT_REFRESH_INTERVAL_SECS=300

# ══════════════════════════════════════════════════
# Geyser gRPC (Yellowstone)
# ══════════════════════════════════════════════════

# GEYSER_ENDPOINT='https://your-geyser:10000'
# GEYSER_TOKEN='your-token'

# ══════════════════════════════════════════════════
# Testing (for E2E tests only)
# ══════════════════════════════════════════════════

# Funded wallet for live execution tests (~0.1 SOL minimum)
# SIM_PRIVATE_KEY='base58-encoded-private-key'
